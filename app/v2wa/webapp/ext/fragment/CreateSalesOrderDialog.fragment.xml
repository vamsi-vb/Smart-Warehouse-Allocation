<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form">
    <Dialog title="Create Sales Order" contentWidth="600px">
        <content>
            <f:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanXL="4" labelSpanL="4" labelSpanM="4" labelSpanS="12">
                <f:content>
                    <Label text="Customer Name" required="true" />
                    <Input value="{dialogModel>/CustomerName}" />
                    <Label text="Customer Email" required="true" />
                    <Input value="{dialogModel>/CustomerEmail}" type="Email" />
                    <Label text="Latitude" required="true" />
                    <Input value="{dialogModel>/CustomerLatitude}" type="Number" />
                    <Label text="Longitude" required="true" />
                    <Input value="{dialogModel>/CustomerLongitude}" type="Number" />
                </f:content>
            </f:SimpleForm>
            
            <Table items="{dialogModel>/Items}" mode="None">
                <headerToolbar>
                    <OverflowToolbar>
                        <Title text="Items" level="H2" />
                        <ToolbarSpacer />
                        <Button icon="sap-icon://add" text="Add Item" press=".onAddItem" />
                    </OverflowToolbar>
                </headerToolbar>
                <columns>
                    <Column>
                        <Text text="Product ID" />
                    </Column>
                    <Column>
                        <Text text="Quantity" />
                    </Column>
                    <Column width="4em" hAlign="End">
                        <Text text="" />
                    </Column>
                </columns>
                <items>
                    <ColumnListItem>
                        <cells>
                            <Input value="{dialogModel>ProductId}" />
                            <Input value="{dialogModel>quantity}" type="Number" />
                            <Button icon="sap-icon://delete" type="Transparent" press=".onDeleteItem" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>
        <beginButton>
            <Button text="Create" type="Emphasized" press=".onCreateDialogSubmit" />
        </beginButton>
        <endButton>
            <Button text="Cancel" press=".onCreateDialogCancel" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
