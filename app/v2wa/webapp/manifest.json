{
  "_version": "1.16.0",

  "sap.app": {
    "id": "smart.warehouse.fe.v2",
    "type": "application",
    "title": "Smart Warehouse Allocation",
    "description": "Smart Warehouse Allocation Application",
    "applicationVersion": {
      "version": "1.0.0"
    },

    "dataSources": {
      "mainService": {
        "uri": "/odata/v2/catalog/",
        "type": "OData",
        "settings": {
          "odataVersion": "2.0",
          "localUri": "localService/metadata.xml",
          "annotations": [
            "localAnnotations"
          ]
        }
      },

      "localAnnotations": {
        "type": "ODataAnnotation",
        "uri": "annotations/annotations.xml"
      }
    }
  },

  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },

  "sap.ui5": {
    "dependencies": {
      "minUI5Version": "1.96.0",
      "libs": {
        "sap.ui.core": {},
        "sap.m": {},
        "sap.ui.generic.app": {},
        "sap.suite.ui.generic.template": {}
      }
    },
    "extends": {
      "extensions": {
        "sap.ui.controllerExtensions": {
          "sap.suite.ui.generic.template.ListReport.view.ListReport": {
            "controllerName": "smart.warehouse.fe.v2.ext.controller.ListReportExt",
            "sap.ui.generic.app": {
              "SalesOrders": {
                "EntitySet": "SalesOrders",
                "Actions": {
                  "CreateSalesOrder": {
                    "id": "CreateSalesOrderButton",
                    "text": "Create Order",
                    "press": "onCreateSalesOrder",
                    "requiresSelection": false,
                    "global": true
                  }
                }
              }
            }
          },
          "sap.suite.ui.generic.template.ObjectPage.view.Details": {
            "controllerName": "smart.warehouse.fe.v2.ext.controller.ObjectPageExt"
          }
        },
        "sap.ui.viewExtensions": {
          "sap.suite.ui.generic.template.ObjectPage.view.Details": {
            "BeforeFacet|SalesOrders|ItemsFacet": {
              "className": "sap.ui.core.Fragment",
              "fragmentName": "smart.warehouse.fe.v2.ext.fragment.CustomSection",
              "type": "XML"
            }
          }
        }
      }
    },
    "models": {
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "defaultBindingMode": "TwoWay",
          "defaultCountMode": "Inline"
        }
      },
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "smart.warehouse.fe.v2.i18n.i18n"
        }
      }
    }
  },

  "sap.ui.generic.app": {
    "_version": "1.2.0",
    
    "pages": [
      {
        "entitySet": "SalesOrders",
        "component": {
          "name": "sap.suite.ui.generic.template.ListReport",
          "list": true,
          "settings": {
            "dataLoadSettings": {
              "loadDataOnAppLaunch": "always"
            },
            "quickVariantSelectionX": {
              "variants": {
                "0": {
                  "key": "sales",
                  "annotationPath": "com.sap.vocabularies.UI.v1.SelectionPresentationVariant#sales"
                },
                "1": {
                  "key": "all",
                  "entitySet": "Warehouses",
                  "annotationPath": "com.sap.vocabularies.UI.v1.SelectionPresentationVariant#all"
                },
                "2": {
                  "key": "active",
                  "entitySet": "Warehouses",
                  "annotationPath": "com.sap.vocabularies.UI.v1.SelectionPresentationVariant#active"
                }
              }
            }
          }
        },
        "pages": [
          {
            "entitySet": "SalesOrders",
            "component": {
              "name": "sap.suite.ui.generic.template.ObjectPage"
            },
            "pages": [
              {
                "entitySet": "Items",
                "navigationProperty": "item",
                "component": {
                  "name": "sap.suite.ui.generic.template.ObjectPage"
                }
              }
            ]
          },
          {
            "entitySet": "Warehouses",
            "component": {
              "name": "sap.suite.ui.generic.template.ObjectPage"
            }
          }
        ]
      }
    ]
  }
}