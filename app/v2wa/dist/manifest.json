{
	"_version": "1.16.0",
	"sap.app": {
		"id": "smart.warehouse.fe.v2",
		"type": "application",
		"title": "Smart Warehouse Allocation",
		"description": "Smart Warehouse Allocation Application",
		"applicationVersion": {
			"version": "1.0.0"
		},
		"dataSources": {
			"mainService": {
				"uri": "/odata/v2/catalog/",
				"type": "OData",
				"settings": {
					"odataVersion": "2.0",
					"localUri": "localService/metadata.xml",
					"annotations": [
						"localAnnotations"
					]
				}
			},
			"localAnnotations": {
				"type": "ODataAnnotation",
				"uri": "annotations/annotations.xml"
			}
		}
	},
	"sap.ui": {
		"technology": "UI5",
		"deviceTypes": {
			"desktop": true,
			"tablet": true,
			"phone": true
		}
	},
	"sap.ui5": {
		"dependencies": {
			"minUI5Version": "1.96.0",
			"libs": {
				"sap.ui.core": {},
				"sap.m": {},
				"sap.ui.generic.app": {},
				"sap.suite.ui.generic.template": {}
			}
		},
		"models": {
			"": {
				"dataSource": "mainService",
				"preload": true,
				"settings": {
					"defaultBindingMode": "TwoWay",
					"defaultCountMode": "Inline"
				}
			},
			"i18n": {
				"type": "sap.ui.model.resource.ResourceModel",
				"settings": {
					"bundleName": "smart.warehouse.fe.v2.i18n.i18n"
				}
			}
		},
		"flexBundle": false
	},
	"sap.ui.generic.app": {
		"_version": "1.2.0",
		"pages": [
			{
				"entitySet": "SalesOrders",
				"component": {
					"name": "sap.suite.ui.generic.template.ListReport",
					"list": true
				},
				"pages": [
					{
						"entitySet": "SalesOrders",
						"component": {
							"name": "sap.suite.ui.generic.template.ObjectPage"
						},
						"pages": [
							{
								"entitySet": "Items",
								"navigationProperty": "item",
								"component": {
									"name": "sap.suite.ui.generic.template.ObjectPage"
								}
							}
						]
					}
				]
			}
		]
	}
}